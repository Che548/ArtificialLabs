{
  "expo": {
    "name": "сфера.",
    "slug": "private-expo",
    "scheme": "private-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDECE5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.privateexpo",
      "associatedDomains": [
        "webcredentials:artificiallabs.bebra42.ru",
        "applinks:artificiallabs.bebra42.ru"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "package": "com.anonymous.privateexpo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/StackSansNotch-VariableFont_wght.ttf",
            "./assets/fonts/SF-Pro-Display-Regular.otf",
            "./assets/fonts/SF-Pro-Display-Medium.otf",
            "./assets/fonts/SF-Pro-Display-Semibold.otf",
            "./assets/fonts/SF-Pro-Display-Bold.otf",
            "./assets/fonts/Yaro-Rg-Regular.otf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#EA4087",
          "defaultChannel": "health-reminders"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите приложению «сфера.» выбирать фотографии тестов из медиатеки."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите приложению «сфера.» использовать камеру для сканирования QR-кодов и тестов.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-camera-controls",
      "./plugins/with-android-config-changes",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Разрешите приложению «сфера.» защищать локальные медицинские данные."
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/figma/pregnancy_background.png",
            "./assets/figma/today_pregnancy_background.png",
            "./assets/pregnancy-weeks/1.png",
            "./assets/pregnancy-weeks/2.png",
            "./assets/pregnancy-weeks/3.png",
            "./assets/pregnancy-weeks/4.png",
            "./assets/pregnancy-weeks/5.png",
            "./assets/pregnancy-weeks/6.png",
            "./assets/pregnancy-weeks/7.png",
            "./assets/pregnancy-weeks/8.png",
            "./assets/pregnancy-weeks/9.png",
            "./assets/pregnancy-weeks/10.png",
            "./assets/pregnancy-weeks/11.png",
            "./assets/pregnancy-weeks/12.png",
            "./assets/pregnancy-weeks/13.png",
            "./assets/pregnancy-weeks/14.png",
            "./assets/pregnancy-weeks/15.png",
            "./assets/pregnancy-weeks/16.png",
            "./assets/pregnancy-weeks/17.png",
            "./assets/pregnancy-weeks/18.png",
            "./assets/pregnancy-weeks/19.png",
            "./assets/pregnancy-weeks/20.png",
            "./assets/pregnancy-weeks/21.png",
            "./assets/pregnancy-weeks/22.png",
            "./assets/pregnancy-weeks/23.png",
            "./assets/pregnancy-weeks/24.png",
            "./assets/pregnancy-weeks/25.png",
            "./assets/pregnancy-weeks/26.png",
            "./assets/pregnancy-weeks/27.png",
            "./assets/pregnancy-weeks/28.png",
            "./assets/pregnancy-weeks/29.png",
            "./assets/pregnancy-weeks/30.png",
            "./assets/pregnancy-weeks/31.png",
            "./assets/pregnancy-weeks/32.png",
            "./assets/pregnancy-weeks/33.png",
            "./assets/pregnancy-weeks/34.png",
            "./assets/pregnancy-weeks/35.png",
            "./assets/pregnancy-weeks/36.png",
            "./assets/pregnancy-weeks/37.png",
            "./assets/pregnancy-weeks/38.png",
            "./assets/pregnancy-weeks/39.png",
            "./assets/pregnancy-weeks/40.png",
            "./assets/figma/scan-screen/background.png",
            "./assets/figma/scan-screen/scan_flow_qr_final.png",
            "./assets/figma/scan-screen/scan_flow_qr.png",
            "./assets/figma/scan-screen/scan_test_strip.png",
            "./assets/instructions/step_1_cup.png",
            "./assets/instructions/step_2_package.png",
            "./assets/instructions/step_3_dip_test.png",
            "./assets/instructions/step_4_test_strip.png",
            "./assets/instructions/step_5_results.png",
            "./assets/tab-icons/analyses_selected.png",
            "./assets/tab-icons/analyses.png",
            "./assets/tab-icons/chat_selected.png",
            "./assets/tab-icons/chat.png",
            "./assets/tab-icons/profile_selected.png",
            "./assets/tab-icons/profile.png",
            "./assets/tab-icons/scan_selected.png",
            "./assets/tab-icons/scan.png",
            "./assets/tab-icons/today_selected.png",
            "./assets/tab-icons/today.png"
          ]
        }
      ],
      "expo-background-task"
    ]
  }
}
