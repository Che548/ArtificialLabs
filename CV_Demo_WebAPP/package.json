  "dependencies": { "next": "16.3.2", "react": "19.1.0", "react-dom": "19.1.0", "sharp": "^0.34.5", "jsqr": "^1.4.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "typescript": "^5.7.2", "@types/node": "^22.10.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "tsx": "^4.20.0", "@playwright/test": "^1.55.0" }
}
