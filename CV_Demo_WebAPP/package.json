{
  "name": "sfera-cv-demo-webapp", "version": "1.0.0", "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3040",
    "build": "next build", "start": "next start --hostname 0.0.0.0 --port 3040",
    "build:cv": "node ../scripts/verify-strip-reader-package.mjs && node ../scripts/build-strip-cv.mjs --cli-only",
