# Persistent directory for signed sessions and revocable links (not medical images).
CV_DEMO_DATA_DIR=.data
# Optional absolute path; default points to the shared StripCV binary.
# STRIPCV_CLI=/app/web-build/stripcv-native/stripcv_cli
# Optional absolute directory containing the same five frozen mobile ONNX models.
# STRIPCV_MODELS=/app/modules/strip-cv/models/reader-20260914
# Behind a TLS reverse proxy, set the exact public origin.
# CV_DEMO_PUBLIC_ORIGIN=https://demo.example.com
