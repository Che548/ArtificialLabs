# Public URL used by the Expo client.
EXPO_PUBLIC_CONVEX_URL=https://artificiallabs-convex.bebra42.ru
EXPO_PUBLIC_CONVEX_SITE_URL=https://artificiallabs-convex-site.bebra42.ru

# Optional local-only CV test controls. Do not enable for release builds.
# EXPO_PUBLIC_ENABLE_STRIPCV_TEST_MODE=1

# Used only by the Convex CLI. Never commit a real admin key.
CONVEX_SELF_HOSTED_URL=https://artificiallabs-convex.bebra42.ru
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-generated-admin-key

# Convex Auth also requires JWT_PRIVATE_KEY and JWKS to be configured on the
# deployment with `npx convex env set`. They are secrets and never belong here.
