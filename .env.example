# Public URL used by the Expo client.
EXPO_PUBLIC_CONVEX_URL=https://artificiallabs-convex.bebra42.ru
EXPO_PUBLIC_CONVEX_SITE_URL=https://artificiallabs-convex-site.bebra42.ru
NEXT_PUBLIC_CONVEX_URL=https://artificiallabs-convex.bebra42.ru

# Optional local-only CV test controls. Do not enable for release builds.
# EXPO_PUBLIC_ENABLE_STRIPCV_TEST_MODE=1

# Used only by the Convex CLI. Never commit a real admin key.
CONVEX_SELF_HOSTED_URL=https://artificiallabs-convex.bebra42.ru
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-generated-admin-key

# Convex Auth also requires JWT_PRIVATE_KEY and JWKS to be configured on the
# deployment with `npx convex env set`. They are secrets and never belong here.
# CALIBRATION_SIGNING_PRIVATE_KEY and ANALYTICS_HASH_SECRET are also set only
# in the Convex deployment environment. Never prefix them with EXPO_PUBLIC_ or
# NEXT_PUBLIC_, and never pass them to Docker builds.
# SMS_AUTH_ENABLED, SMS_GATEWAY_SHARED_SECRET and SMS_RATE_LIMIT_HASH_SECRET
# are deployment-only values. The shared secret must match the private gateway
# container on junk; never expose these values as public variables.
# SMS_BALANCE_USSD_CODE defaults to *105#. It is used only by the private SMS
# gateway for an admin-triggered tariff check and is not a client variable.
