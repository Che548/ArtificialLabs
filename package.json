{
  "name": "privateexpo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.36",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "prettier": "^3.9.6",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:expo": "expo install --check",
    "doctor": "npx --yes expo-doctor@latest",
    "build:web": "expo export --platform web --output-dir dist",
    "build:strip-cv": "node scripts/build-strip-cv.mjs",
    "web:serve": "node scripts/web-server.mjs",
    "web:full": "npm run build:web && npm run build:strip-cv && npm run web:serve",
    "verify": "npm run check:expo && npm run typecheck && npm run doctor && npm run build:web"
  },
  "engines": {
    "node": ">=22.13.1"
  },
  "private": true
}
