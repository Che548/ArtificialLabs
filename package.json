{
  "name": "privateexpo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.94",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "convex": "^1.42.3",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "convex-test": "^0.0.54",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-native-svg-transformer": "^1.5.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "PATH=/opt/homebrew/opt/node@22/bin:$PATH expo run:android",
    "ios": "PATH=/opt/homebrew/opt/node@22/bin:$PATH LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
    "web": "expo start --web",
    "convex:dev": "convex dev --env-file .env.local",
    "convex:deploy": "convex dev --once --env-file .env.local",
    "convex:codegen": "convex codegen",
    "typecheck": "tsc --noEmit",
    "check:expo": "expo install --check",
    "doctor": "npx --yes expo-doctor@latest",
    "build:web": "expo export --platform web --output-dir dist",
    "build:strip-cv": "node scripts/build-strip-cv.mjs",
    "test:strip-cv": "npm run build:strip-cv && ctest --test-dir web-build/stripcv-native --output-on-failure && tsx scripts/smoke-strip-cv.mjs && npm run test:strip-cv-server",
    "test:strip-cv-server": "tsx scripts/smoke-strip-cv-server.mjs",
    "web:serve": "node scripts/web-server.mjs",
    "web:full": "npm run build:web && npm run build:strip-cv && npm run web:serve",
    "test": "tsx --test services/scanning/profile-qr.test.ts services/scanning/result-interpretation.test.ts services/scanning/scan-overlay-geometry.test.ts modules/strip-cv/src/StripCv.web-request.test.ts lib/cloud-sync.test.ts lib/data-transfer.test.ts lib/sync-policy.test.ts && vitest run convex/health.test.ts",
    "e2e:backend": "node --env-file-if-exists=.env.local --import tsx tests/e2e/backend.live.ts",
    "e2e:web": "playwright test tests/e2e/web.spec.ts",
    "e2e:native": "./scripts/run-native-e2e.sh",
    "e2e:all": "npm run e2e:backend && npm run e2e:web && npm run e2e:native",
    "e2e:cleanup": "node --env-file-if-exists=.env.local --import tsx tests/e2e/native-account.ts cleanup",
    "verify": "npm run check:expo && npm run typecheck && npm run doctor && npm run build:web"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "private": true
}
